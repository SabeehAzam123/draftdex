# Optional. Copy to .env.local to change a default. With no file at all, DraftDex runs locally on a
# SQLite file in data/ with a development signing secret.

# A local file (default) or a Turso database for a hosted copy, e.g. libsql://draftdex-you.turso.io
DATABASE_URL=file:./data/draftdex.db
# DATABASE_AUTH_TOKEN=

# Required in production: at least 32 random characters
# JWT_SECRET=
JWT_EXPIRES_IN=8h

# Hosts league notifications may be sent to (comma-separated; subdomains count)
WEBHOOK_ALLOWED_HOSTS=discord.com,discordapp.com
